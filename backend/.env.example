# LLM configuration (HelloAgents reads LLM_* env vars)
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=60

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Unsplash API (attraction images)
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Amap Web Service API (backend MCP tools)
AMAP_API_KEY=your_amap_api_key_here

# Observability & Tracing (LangSmith / 云端调用看板，选填)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=lsv2_pt_xxxx
# LANGCHAIN_PROJECT=helloagents-trip-planner
