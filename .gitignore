# ==========================================
# 敏感配置（最高优先级：严防 API Key 泄露）
# ==========================================
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# ==========================================
# 依赖包（体积巨大，禁止提交）
# ==========================================
node_modules/
frontend/node_modules/
venv/
.venv/
env/
ENV/

# ==========================================
# Python 编译与临时文件
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
backend/__pycache__/
backend/**/__pycache__/

# ==========================================
# 前端构建产物
# ==========================================
frontend/dist/
frontend/dist-ssr/

# ==========================================
# 日志与临时调试数据
# ==========================================
logs/
*.log
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/data/*.sqlite
backend/data/*.sqlite*
*.sqlite-journal
*.sqlite3-journal

# ==========================================
# IDE 与操作系统临时文件
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
